{
  "name": "rulers-of-russia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:history": "node scripts/validate-history-core.mjs",
    "materialize:history-geometry": "node scripts/build-history-geometry.mjs",
    "materialize:history-territory": "node scripts/materialize-history-territory.mjs",
    "materialize:history-boundaries": "node scripts/build-history-boundary-index.mjs",
    "materialize:history": "npm run materialize:history-geometry && npm run materialize:history-territory && npm run materialize:history-boundaries && node scripts/build-history-month-index.mjs && node scripts/build-history-event-index.mjs && node scripts/build-history-completion-report.mjs"
  },
  "dependencies": {
    "@mapbox/geojson-rewind": "0.5.2",
    "d3-geo": "3.1.1",
    "maplibre-gl": "^6.0.0",
    "next": "16.3.1",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.180.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.0",
    "typescript": "^5.8.0"
  }
}
